function ListCard({ title, items, tone = "default" }) {
  const toneClass = useMemo(() => {
    if (tone === "good") return "from-emerald-400/10 to-transparent border-emerald-400/15";
    if (tone === "warn") return "from-amber-400/10 to-transparent border-amber-400/15";
    return "from-cyan-400/10 to-transparent border-cyan-400/15";
  }, [tone]);

  return (
    <div className={`rounded-3xl border bg-gradient-to-br ${toneClass} p-6`}>
      <h3 className="mb-4 text-xl font-semibold text-white">{title}</h3>
      <div className="space-y-3">
        {items.map((item, idx) => (
          <div key={idx} className="flex gap-3 rounded-2xl bg-black/20 px-4 py-3">
            <div className="mt-1 h-2 w-2 shrink-0 rounded-full bg-cyan-300" />
            <p className="text-sm leading-7 text-slate-200">{item}</p>
          </div>
        ))}
      </div>
    </div>
  );
}

function ScoreRing({ score }) {
  const dash = 339.292;
  const progress = dash - (dash * score) / 100;
  const good = score >= 75;
  return (
    <GlassCard className="p-6">
      <div className="mb-5 flex items-center justify-between">
        <div>
          <div className="text-xs uppercase tracking-[0.24em] text-slate-400">Match Score</div>
          <div className="mt-2 text-2xl font-semibold text-white">岗位匹配度</div>
        </div>
        <div
          className={`rounded-full px-3 py-1 text-xs font-medium ${
            good
              ? "border border-emerald-400/20 bg-emerald-400/10 text-emerald-300"
              : "border border-amber-400/20 bg-amber-400/10 text-amber-300"
          }`}
        >
          {good ? "可直接投递" : "建议优化后投递"}
        </div>
      </div>

      <div className="flex flex-col items-center gap-6 md:flex-row md:justify-between">
        <div className="relative h-44 w-44">
          <svg viewBox="0 0 120 120" className="h-full w-full -rotate-90">
            <circle cx="60" cy="60" r="54" fill="none" stroke="rgba(255,255,255,0.08)" strokeWidth="8" />
            <circle
              cx="60"
              cy="60"
              r="54"
              fill="none"
              stroke="url(#grad)"
              strokeWidth="8"
              strokeLinecap="round"
              strokeDasharray={dash}
              strokeDashoffset={progress}
            />
            <defs>
              <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stopColor="#67e8f9" />
                <stop offset="100%" stopColor="#8b5cf6" />
              </linearGradient>
            </defs>
          </svg>
          <div className="absolute inset-0 flex flex-col items-center justify-center">
            <div className="text-4xl font-bold text-white">{score}</div>
            <div className="mt-1 text-xs uppercase tracking-[0.24em] text-slate-400">/ 100</div>
          </div>
        </div>

        <div className="grid flex-1 grid-cols-1 gap-3 md:grid-cols-2">
          <StatPill icon={Gauge} label="阈值" value="75 分" />
          <StatPill icon={Clock3} label="预计耗时" value="18 秒" />
